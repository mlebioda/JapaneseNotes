@startuml vault-system-diagram
title ObsidianJP Vault — Agent & Skill System

' ─── Shared storage ───
database ".claude/agents/" as AgentsDir
database ".cowork/skills/" as SkillsDir
database ".cowork/instructions.md" as Instructions
database "Plans/" as PlansDir
database "Scribe/" as ScribeDir
database "docs/" as DocsDir
database "JPLessons/" as LessonsDir
database "grammar-index/" as GrammarIndexDir
database "Vocabulary/" as VocabularyDir
database "Caligraphy/" as CaligraphyDir
database ".cowork/progress/" as ProgressDir
database "vault root (*.ics)" as VaultRootIcs
database "English-gaps/" as EnglishGapsDir
database ".cowork/tmp/" as TmpDir
database "KanjiList.md" as KanjiListFile

' ─── Agents ───
package "Agents" {
  component [reviewer] as Reviewer <<agent>>
  note right of Reviewer
    tools: Read, Bash, Agent
    reads: .cowork/skills/, .claude/agents/,
           .cowork/instructions.md, Plans/, Scribe/
    no access: JPLessons/
    never writes any file
    calls planner (A2A) when issues warrant a plan
  end note

  component [planner] as Planner <<agent>>
  note right of Planner
    tools: Read, Write, Edit, Bash, Agent
    reads/writes: Plans/ only
    calls skill-implementer / reviewer / scribe (A2A, user-chosen)
  end note

  component [skill-implementer] as SkillImplementer <<agent>>
  note right of SkillImplementer
    tools: Read, Write, Edit, Bash, Agent
    reads: Plans/, .cowork/skills/, .cowork/progress/,
           grammar-index/, Vocabulary/, JPLessons/ (RO)
    writes: .cowork/skills/, .claude/agents/, Plans/ (checkboxes),
            grammar-index/, Vocabulary/ (confirmed)
    calls documentation automatically after skill/agent file changes
    calls reviewer / scribe (A2A, user-chosen) at end of session
    never pushes to git
  end note

  component [documentation] as Documentation <<agent>>
  note right of Documentation
    tools: Read, Write, Edit, Bash, Agent
    reads: .claude/agents/, .cowork/skills/, .cowork/instructions.md
    writes: docs/ only (via generate-diagram skill)
    no access: JPLessons/, Plans/, Scribe/
    does not call scribe itself (generate-diagram skill does, if user opts in)
  end note

  component [scribe] as Scribe <<agent>>
  note right of Scribe
    tools: Read, Write, Edit, Bash (no Agent — never calls other agents)
    reads: .cowork/ (RO), .claude/ (RO)
    writes: Scribe/ only
    no access: JPLessons/
    modes: capture, git-sweep, retrospect, post
  end note
}

package "Deprecated" {
  component [orchestrator] as Orchestrator <<agent>> <<deprecated>>
  note right of Orchestrator
    DEPRECATED — replaced by direct agent routing
    (reviewer → planner → skill-implementer)
    tools: Read, Bash, Agent
    sole permitted write: .cowork/tmp/orchestrator-handoff.md
  end note

  component [skill-updater] as SkillUpdater <<agent>> <<deprecated>>
  note right of SkillUpdater
    DEPRECATED — replaced by reviewer + planner + skill-implementer
    tools: Read, Write, Edit, Bash, Agent
    calls scribe automatically after each modified file
  end note
}

' ─── Agent → Agent calls (A2A) ───
Orchestrator --> Reviewer : calls
Orchestrator --> Planner : calls
Orchestrator --> SkillImplementer : calls
Reviewer --> Planner : calls (A2A brief, if issues warrant)
Planner --> SkillImplementer : calls (optional, user-chosen)
Planner --> Reviewer : calls (optional, user-chosen)
Planner --> Scribe : calls (optional, user-chosen)
SkillImplementer --> Documentation : calls (auto, after skill/agent file change)
SkillImplementer --> Reviewer : calls (optional, user-chosen)
SkillImplementer --> Scribe : calls (optional, user-chosen)
SkillUpdater --> Scribe : calls (auto, per modified file)

' ─── Agent → Skill ───
Documentation --> GenerateDiagram : loads

' ─── Agent → Storage ───
Orchestrator ..> PlansDir : reads
Orchestrator --> TmpDir : writes (handoff slug — sole write)
Reviewer ..> SkillsDir : reads
Reviewer ..> AgentsDir : reads
Reviewer ..> Instructions : reads
Reviewer ..> PlansDir : reads
Reviewer ..> ScribeDir : reads
Planner ..> PlansDir : reads
Planner --> PlansDir : writes
SkillImplementer ..> PlansDir : reads
SkillImplementer --> SkillsDir : writes
SkillImplementer --> AgentsDir : writes
SkillImplementer --> PlansDir : writes
SkillImplementer --> GrammarIndexDir : writes
SkillImplementer --> VocabularyDir : writes
SkillImplementer ..> LessonsDir : reads
SkillUpdater ..> SkillsDir : reads
SkillUpdater --> SkillsDir : writes
SkillUpdater --> Instructions : writes (confirmed)
SkillUpdater ..> LessonsDir : reads
Documentation ..> AgentsDir : reads
Documentation ..> SkillsDir : reads
Documentation ..> Instructions : reads
Documentation --> DocsDir : writes
Scribe --> ScribeDir : writes
Scribe ..> SkillsDir : reads
Scribe ..> AgentsDir : reads

' ─── Skills (top-level) ───
package "Skills (top-level)" {
  component [generate-diagram] as GenerateDiagram <<skill>>
  component [add-word-to-deck] as AddWordToDeck <<skill>>
  component [reading-jlpt] as ReadingJlpt <<skill>>
  component [fill-templates] as FillTemplates <<skill>>
  note right of FillTemplates
    script: fill_extract.py
  end note
  component [templates-update] as TemplatesUpdate <<skill>>
  note right of TemplatesUpdate
    scripts: .cowork/scripts/preprocess-templates.py
             .cowork/scripts/kanji-links.py
  end note
  component [git-commit] as GitCommit <<skill>>
  component [kanji-headers] as KanjiHeaders <<skill>>
  component [kanji-file] as KanjiFile <<skill>>
  component [_heading-roles] as HeadingRoles <<skill>>
  component [summarize-grammar] as SummarizeGrammar <<skill>>
  component [extract-vocabulary] as ExtractVocabulary <<skill>>
  component [english-to-polish-grammar] as EnglishToPolishGrammar <<skill>>
  component [manage-holidays] as ManageHolidays <<skill>>
  note right of ManageHolidays
    scripts: .cowork/scripts/load-control.py
             .cowork/scripts/ics-export.py
  end note
}

package "Deprecated skills" {
  component [update-kanji-list] as UpdateKanjiList <<skill>> <<deprecated>>
  note right of UpdateKanjiList
    DEPRECATED — superseded by kanji-headers (Steps 2 & 5)
    and kanji-file
  end note
}

' ─── Skills (practice-grammar) ───
package "Skills (practice-grammar)" {
  component [practice-grammar/_practice-grammar-common] as PracticeGrammarCommon <<skill>>
  component [practice-grammar/lesson-grammar-practice] as LessonGrammarPractice <<skill>>
  component [practice-grammar/scheduled-grammar-practice] as ScheduledGrammarPractice <<skill>>
  component [practice-grammar/practice-grammar-study-mode] as PracticeGrammarStudyMode <<skill>>
  component [practice-grammar/practice-grammar-srs] as PracticeGrammarSrs <<skill>>
  note right of PracticeGrammarSrs
    scripts: .cowork/scripts/load-control.py
             .cowork/scripts/ics-export.py
  end note
}

' ─── Skills (lesson-to-web) ───
package "Skills (lesson-to-web)" {
  component [lesson-to-web/_conventions] as Conventions <<skill>>
  component [lesson-to-web/_patterns] as Patterns <<skill>>
  component [lesson-to-web/extract-grammar] as ExtractGrammar <<skill>>
  component [lesson-to-web/preprocess-grammar] as PreprocessGrammar <<skill>>
  note right of PreprocessGrammar
    scripts: .claude/scripts/grammar-process.py
             .claude/scripts/furigana-convert.py
  end note
  component [lesson-to-web/review-grammar] as ReviewGrammar <<skill>>
  component [lesson-to-web/structure-grammar] as StructureGrammar <<skill>>
  component [lesson-to-web/register-confusability-grammar] as RegisterConfusabilityGrammar <<skill>>
  component [lesson-to-web/see-also-grammar] as SeeAlsoGrammar <<skill>>
  note right of SeeAlsoGrammar
    script: .claude/scripts/grammar-process.py --set-proofread
  end note
  component [lesson-to-web/update-grammar] as UpdateGrammar <<skill>>
}

' ─── Skills (references) ───
package "Skills (references)" {
  component [references/kanji-links] as KanjiLinksRef <<skill>>
  note right of KanjiLinksRef
    script: .cowork/scripts/kanji-links.py
  end note
  component [references/adj-forms] as AdjFormsRef <<skill>>
  component [references/honorific-forms] as HonorificFormsRef <<skill>>
  component [references/card-templates] as CardTemplatesRef <<skill>>
  component [references/verb-conjugation] as VerbConjugationRef <<skill>>
}

' ─── Skill chains ───
ReadingJlpt --> FillTemplates : chains (optional)
KanjiHeaders --> KanjiFile : calls (per kanji, sequential)
GenerateDiagram --> Scribe : calls (A2A, optional, user-confirmed)

LessonGrammarPractice --> PracticeGrammarCommon : loads
ScheduledGrammarPractice --> PracticeGrammarCommon : loads
PracticeGrammarCommon --> HeadingRoles : loads
PracticeGrammarCommon --> PracticeGrammarStudyMode : loads (Study Mode hookup)
LessonGrammarPractice --> PracticeGrammarStudyMode : loads (direct entry at Step 2)
LessonGrammarPractice --> PracticeGrammarSrs : calls (persist)
ScheduledGrammarPractice --> PracticeGrammarSrs : calls (persist)

ExtractGrammar --> Conventions : loads
ExtractGrammar --> HeadingRoles : loads
PreprocessGrammar --> Conventions : loads
PreprocessGrammar --> Patterns : loads (lazy, on unrecognised input)
ReviewGrammar --> Conventions : loads
StructureGrammar --> Conventions : loads
RegisterConfusabilityGrammar --> Conventions : loads
SeeAlsoGrammar --> Conventions : loads
UpdateGrammar --> Conventions : loads
UpdateGrammar --> PreprocessGrammar : chains (all mode, full pipeline)
ExtractGrammar --> PreprocessGrammar : chains (optional handoff)
PreprocessGrammar --> ReviewGrammar : chains (optional handoff)
ReviewGrammar --> StructureGrammar : chains (optional handoff)
StructureGrammar --> RegisterConfusabilityGrammar : chains (optional handoff)
RegisterConfusabilityGrammar --> SeeAlsoGrammar : chains (optional handoff)

' ─── Skill → Reference skills ───
AddWordToDeck ..> VerbConjugationRef : reads
AddWordToDeck ..> AdjFormsRef : reads
AddWordToDeck ..> HonorificFormsRef : reads
AddWordToDeck ..> KanjiLinksRef : reads
FillTemplates ..> VerbConjugationRef : reads
FillTemplates ..> AdjFormsRef : reads
FillTemplates ..> KanjiLinksRef : reads
FillTemplates ..> HonorificFormsRef : reads
TemplatesUpdate ..> CardTemplatesRef : reads
TemplatesUpdate ..> VerbConjugationRef : reads
TemplatesUpdate ..> AdjFormsRef : reads
TemplatesUpdate ..> KanjiLinksRef : reads
TemplatesUpdate ..> HonorificFormsRef : reads

' ─── Skill → Storage ───
GenerateDiagram ..> AgentsDir : reads
GenerateDiagram ..> SkillsDir : reads
GenerateDiagram ..> Instructions : reads
GenerateDiagram --> DocsDir : writes

AddWordToDeck --> VocabularyDir : writes
AddWordToDeck ..> Instructions : reads
AddWordToDeck ..> KanjiListFile : reads

ReadingJlpt --> LessonsDir : writes (JPLessons/Reading/ session files)

FillTemplates --> LessonsDir : writes (# Summary section)

TemplatesUpdate --> LessonsDir : writes (# Summary section repairs)

GitCommit --> LessonsDir : writes (git add/commit/push)

KanjiHeaders --> CaligraphyDir : writes
KanjiHeaders --> KanjiListFile : writes
KanjiHeaders --> LessonsDir : writes (## headers, wikilinks in calligraphy files)

KanjiFile --> CaligraphyDir : writes

UpdateKanjiList --> CaligraphyDir : writes
UpdateKanjiList --> KanjiListFile : writes
UpdateKanjiList ..> LessonsDir : reads

SummarizeGrammar --> GrammarIndexDir : writes
SummarizeGrammar ..> LessonsDir : reads

ExtractVocabulary --> VocabularyDir : writes
ExtractVocabulary ..> LessonsDir : reads

EnglishToPolishGrammar --> EnglishGapsDir : writes

ManageHolidays --> ProgressDir : writes
ManageHolidays ..> ProgressDir : reads
ManageHolidays --> VaultRootIcs : writes

LessonGrammarPractice ..> LessonsDir : reads
LessonGrammarPractice ..> ProgressDir : reads
ScheduledGrammarPractice ..> LessonsDir : reads
ScheduledGrammarPractice ..> GrammarIndexDir : reads (extracted grammar files)
ScheduledGrammarPractice ..> VocabularyDir : reads (vocab base, top level only)
ScheduledGrammarPractice ..> ProgressDir : reads
PracticeGrammarSrs --> ProgressDir : writes (grammar-state.json)
PracticeGrammarSrs ..> ProgressDir : reads
PracticeGrammarSrs --> VaultRootIcs : writes (session .ics)

ExtractGrammar --> GrammarIndexDir : writes
ExtractGrammar ..> LessonsDir : reads
ExtractGrammar --> LessonsDir : writes (wikilink insertion only, pre-Summary)
PreprocessGrammar --> GrammarIndexDir : writes
ReviewGrammar --> GrammarIndexDir : writes
StructureGrammar --> GrammarIndexDir : writes
RegisterConfusabilityGrammar --> GrammarIndexDir : writes
RegisterConfusabilityGrammar ..> LessonsDir : reads (backfill mode only)
SeeAlsoGrammar --> GrammarIndexDir : writes

@enduml
