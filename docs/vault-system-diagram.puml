@startuml vault-system-diagram
title ObsidianJP Vault — Agent & Skill System

' ─── Shared storage ───
database ".claude/agents/" as AgentsDir
database ".cowork/skills/" as SkillsDir
database ".cowork/skills/references/" as ReferencesDir
database ".cowork/scripts/" as CoworkScripts
database ".claude/scripts/" as ClaudeScripts
database ".cowork/instructions.md" as Instructions
database "Plans/" as PlansDir
database "Scribe/" as ScribeDir
database "docs/" as DocsDir
database "JPLessons/" as LessonsDir
database "JPLessons/Reading/" as ReadingDir
database "grammar-index/" as GrammarIndexDir
database "grammar-index/grammar/" as GrammarIndexGrammarDir
database "Vocabulary/" as VocabularyDir
database "Caligraphy/" as CaligraphyDir
database ".cowork/progress/" as ProgressDir
database ".cowork/tmp/" as TmpDir
database "KanjiList.md" as KanjiListFile
database "vault root (.ics exports)" as VaultRootIcs

' ─── Agents ───
package "Agents" {
  component [documentation] as Documentation <<agent>>
  note right of Documentation
    tools: Read, Write, Edit, Bash, Agent
    reads: .claude/agents/, .cowork/skills/,
      .cowork/instructions.md (all read-only)
    writes: docs/ only
    no access: JPLessons/, Plans/, Scribe/
    never modifies skill/agent files
    does not call scribe directly from agent body
      (generate-diagram skill's Step 8 does)
  end note

  component [reviewer] as Reviewer <<agent>>
  note right of Reviewer
    tools: Read, Bash, Agent
    reads: .cowork/skills/, .claude/agents/,
      .cowork/instructions.md, Plans/, Scribe/ (read-only)
    git log/show/diff/status: read-only
    no access: JPLessons/
    never writes or edits any file
    hard rule: never calls scribe (planner does)
  end note

  component [planner] as Planner <<agent>>
  note right of Planner
    tools: Read, Write, Edit, Bash, Agent
    boundary: reads/writes Plans/ only
      (also reads TARGET file under
      REVIEWER_BRIEF mode)
    calls scribe after saving a plan
  end note

  component [skill-implementer] as SkillImplementer <<agent>>
  note right of SkillImplementer
    tools: Read, Write, Edit, Bash, Agent
    writes: .cowork/skills/, .claude/agents/,
      Plans/ (checkbox updates only)
    JPLessons/ writes only if explicitly
      instructed by user
    never pushes to git
    calls documentation automatically (Step 4)
      after any skill/agent file change
  end note

  component [scribe] as Scribe <<agent>>
  note right of Scribe
    tools: Read, Write, Edit, Bash
    reads: .cowork/, .claude/ (read-only)
    git log/show/diff/status: read-only
    writes: Scribe/ only
    no access: JPLessons/
    no Agent tool — cannot call other agents
  end note
}

package 'Deprecated' {
  component [orchestrator] as Orchestrator <<agent>> <<deprecated>>
  note right of Orchestrator
    DEPRECATED — replaced by direct routing:
    reviewer -> planner -> skill-implementer
    tools: Read, Bash, Agent (no Write/Edit)
    sole permitted write: .cowork/tmp/orchestrator-handoff.md
  end note

  component [skill-updater] as SkillUpdater <<agent>> <<deprecated>>
  note right of SkillUpdater
    DEPRECATED — replaced by reviewer + planner
    + skill-implementer pipeline
    tools: Read, Write, Edit, Bash, Agent
    writes: .cowork/skills/ (existing files only,
      never creates new skills)
  end note
}

' ─── Agent -> Agent calls (A2A) ───
Orchestrator --> Reviewer : calls
Orchestrator --> Planner : calls
Orchestrator --> SkillImplementer : calls
Orchestrator --> Scribe : calls (post mode only)
Reviewer --> Planner : calls (if issues warrant a plan)
Planner --> Scribe : calls (after plan saved)
Planner ..> SkillImplementer : suggests next (user-gated)
SkillImplementer --> Documentation : calls (Step 4, automatic)
SkillImplementer ..> Reviewer : suggests next (user-gated)
SkillImplementer ..> Scribe : optional (user-gated)
SkillUpdater --> Scribe : calls (per modified file)
Documentation --> GenerateDiagram : loads skill

' ─── Agent -> Storage ───
Documentation ..> AgentsDir : reads
Documentation ..> SkillsDir : reads
Documentation ..> Instructions : reads
Documentation --> DocsDir : writes

Reviewer ..> SkillsDir : reads
Reviewer ..> AgentsDir : reads
Reviewer ..> Instructions : reads
Reviewer ..> PlansDir : reads
Reviewer ..> ScribeDir : reads

Planner ..> PlansDir : reads
Planner --> PlansDir : writes

SkillImplementer ..> PlansDir : reads
SkillImplementer --> PlansDir : writes (task checkboxes)
SkillImplementer --> SkillsDir : writes
SkillImplementer --> AgentsDir : writes
SkillImplementer ..> LessonsDir : reads (context only)
SkillImplementer --> LessonsDir : writes (only if explicit)

Scribe --> ScribeDir : writes
Scribe ..> SkillsDir : reads
Scribe ..> AgentsDir : reads

Orchestrator ..> PlansDir : reads
Orchestrator --> TmpDir : writes (handoff slug only)

SkillUpdater --> SkillsDir : writes
SkillUpdater ..> Instructions : reads
SkillUpdater ..> PlansDir : reads
SkillUpdater ..> LessonsDir : reads (context only)

' ─── Skills (top-level) ───
package "Skills (top-level)" {
  component [generate-diagram] as GenerateDiagram <<skill>>
  component [extract-vocabulary] as ExtractVocabulary <<skill>>
  component [fill-templates] as FillTemplates <<skill>>
  component [git-commit] as GitCommit <<skill>>
  component [kanji-file] as KanjiFile <<skill>>
  component [kanji-headers] as KanjiHeaders <<skill>>
  component [manage-holidays] as ManageHolidays <<skill>>
  component [practice-grammar] as PracticeGrammar <<skill>>
  component [practice-grammar-srs] as PracticeGrammarSRS <<skill>>
  component [practice-grammar-study-mode] as PracticeGrammarStudyMode <<skill>>
  component [reading-jlpt] as ReadingJlpt <<skill>>
  component [summarize-grammar] as SummarizeGrammar <<skill>>
  component [templates-update] as TemplatesUpdate <<skill>>
  component [update-kanji-list] as UpdateKanjiList <<skill>> <<deprecated>>

  note bottom of GitCommit
    Not part of the agent pipeline — runs git add/commit/push
    directly on user confirmation. No agent invokes this skill.
    GAP: not listed anywhere in .cowork/instructions.md's
      "Available skills" registry — orphaned/undocumented skill.
  end note

  note bottom of ExtractVocabulary
    GAP: .cowork/instructions.md lists this as
      "lesson-to-web/extract-vocabulary" but the actual file
      lives at .cowork/skills/extract-vocabulary.md (top-level,
      not under lesson-to-web/) — path mismatch in the registry.
  end note

  note bottom of UpdateKanjiList
    DEPRECATED — superseded by kanji-headers (Steps 2 & 5)
    and the kanji-file skill. Retained for reference only.
  end note
}

' ─── Skills (lesson-to-web) ───
package "Skills (lesson-to-web)" {
  component [lesson-to-web/_conventions] as Conventions <<reference>>
  component [lesson-to-web/_patterns] as Patterns <<reference>>
  component [lesson-to-web/extract-grammar] as ExtractGrammar <<skill>>
  component [lesson-to-web/preprocess-grammar] as PreprocessGrammar <<skill>>
  component [lesson-to-web/review-grammar] as ReviewGrammar <<skill>>
  component [lesson-to-web/structure-grammar] as StructureGrammar <<skill>>
  component [lesson-to-web/see-also-grammar] as SeeAlsoGrammar <<skill>>
  component [lesson-to-web/update-grammar] as UpdateGrammar <<skill>>

  note bottom of Conventions
    Shared output contract. Loaded unconditionally by every
    lesson-to-web skill before executing any step. Not itself
    trigger-driven (no ## Trigger section).
  end note

  note bottom of Patterns
    Lazy-loaded input-pattern registry. Loaded only when a
    skill encounters an unrecognised source format.
  end note
}

' ─── Skill chains ───
GenerateDiagram --> Scribe : calls (A2A, Step 8)

KanjiHeaders --> KanjiFile : chains (Step 2, sequential per kanji)

PracticeGrammar --> PracticeGrammarSRS : chains (persistence + calendar)
PracticeGrammar --> PracticeGrammarStudyMode : chains (Study Mode, on demand)

ReadingJlpt ..> FillTemplates : chains (optional, Step 7)

ExtractGrammar --> Conventions : loads
ExtractGrammar ..> PreprocessGrammar : chains (optional handoff)
PreprocessGrammar --> Conventions : loads
PreprocessGrammar ..> Patterns : loads (lazy, on unrecognised input)
PreprocessGrammar ..> ReviewGrammar : chains (optional handoff)
ReviewGrammar --> Conventions : loads
ReviewGrammar ..> StructureGrammar : chains (optional handoff)
StructureGrammar --> Conventions : loads
StructureGrammar ..> SeeAlsoGrammar : chains (optional handoff)
SeeAlsoGrammar --> Conventions : loads
UpdateGrammar --> Conventions : loads
UpdateGrammar --> PreprocessGrammar : chains (forces "all" mode)

' ─── Skill -> Storage ───
ExtractVocabulary ..> LessonsDir : reads (up to # Summary only)
ExtractVocabulary --> VocabularyDir : writes (words-extracted.md)

FillTemplates ..> LessonsDir : reads/writes (# Summary section)
FillTemplates ..> ReferencesDir : reads (verb-conjugation, adj-forms,\nhonorific-forms, kanji-links)
note right of FillTemplates
  script: python3 /sessions/stoic-serene-brahmagupta/mnt/ObsidianJP/
    .cowork/skills/fill_extract.py <lesson_bash_path> KanjiList.md
  GAP: hardcoded remote sandbox mount path in skill body —
    inconsistent with the vault-root path convention
    used by every other skill's script invocation
end note

GitCommit ..> LessonsDir : reads (git status/diff)

KanjiFile ..> CaligraphyDir : reads/writes (Kanji/, Primitives/)
note right of KanjiFile
  WebFetch: https://kanji-trainer.org/Mnemonic_phrase/
  (sequential, one kanji at a time — rate-limit rule)
end note

KanjiHeaders ..> LessonsDir : reads/writes (## headers, calligraphy files)
KanjiHeaders --> KanjiListFile : writes (appends new kanji)

ManageHolidays ..> ProgressDir : reads/writes (holidays.json,\ngrammar-state.json, load-control-rules.json)
ManageHolidays --> VaultRootIcs : writes (full-calendar .ics)
note right of ManageHolidays
  scripts: .cowork/scripts/load-control.py
    .cowork/scripts/ics-export.py
end note

PracticeGrammar ..> LessonsDir : reads (up to # Summary only)
PracticeGrammar ..> ProgressDir : reads (grammar-state.json)
PracticeGrammarSRS --> ProgressDir : writes (grammar-state.json)
PracticeGrammarSRS --> VaultRootIcs : writes (session .ics)
note right of PracticeGrammarSRS
  scripts: .cowork/scripts/load-control.py
    .cowork/scripts/ics-export.py
end note
note right of PracticeGrammarStudyMode
  Never writes to grammar-state.json —
  Study Mode exercises are excluded from SRS state.
end note

ReadingJlpt --> ReadingDir : writes (session file)
ReadingJlpt ..> LessonsDir : reads (JPLessons/Reading/ existence check only)

SummarizeGrammar ..> LessonsDir : reads (up to # Summary only)
SummarizeGrammar --> GrammarIndexDir : writes (topic files, index.md)

TemplatesUpdate ..> LessonsDir : reads/writes (# Summary section only)
TemplatesUpdate ..> ReferencesDir : reads (card-templates, verb-conjugation,\nadj-forms, kanji-links, honorific-forms)
note right of TemplatesUpdate
  scripts: .cowork/scripts/preprocess-templates.py
    .cowork/scripts/kanji-links.py
end note

UpdateKanjiList ..> LessonsDir : reads (calligraphy lesson file)
UpdateKanjiList --> CaligraphyDir : writes (Kanji/, Primitives/)
UpdateKanjiList --> KanjiListFile : writes

ExtractGrammar ..> LessonsDir : reads (up to # Summary only)
ExtractGrammar --> GrammarIndexGrammarDir : writes (new grammar-point files)
ExtractGrammar --> LessonsDir : writes (single wikilink insertion, Step 8 only)
ExtractGrammar --> GrammarIndexDir : writes (topic classification, Step 9)

PreprocessGrammar ..> GrammarIndexGrammarDir : reads/writes
note right of PreprocessGrammar
  scripts: .claude/scripts/grammar-process.py
    .claude/scripts/furigana-convert.py
end note

ReviewGrammar ..> GrammarIndexGrammarDir : reads/writes (user-gated edits)

StructureGrammar ..> GrammarIndexGrammarDir : reads/writes (user-confirmed reformat)

SeeAlsoGrammar ..> GrammarIndexGrammarDir : reads/writes (## See also, proofread flag)
SeeAlsoGrammar ..> GrammarIndexDir : reads (topic files, for cross-linking)
note right of SeeAlsoGrammar
  scripts: .claude/scripts/grammar-audit.py --verbose
    .claude/scripts/grammar-process.py --set-proofread
end note

@enduml
